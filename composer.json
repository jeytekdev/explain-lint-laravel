{
    "name": "jeytekdev/explain-lint-laravel",
    "description": "Laravel bridge for jeytekdev/explain-lint — captures queries via DB::listen() and provides a service provider with auto-discovery.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "sql",
        "explain",
        "testing",
        "query-analysis"
    ],
    "homepage": "https://github.com/jeytekdev/explain-lint-laravel",
    "support": {
        "issues": "https://github.com/jeytekdev/explain-lint-laravel/issues",
        "source": "https://github.com/jeytekdev/explain-lint-laravel"
    },
    "authors": [
        {
            "name": "Jeytekdev",
            "homepage": "https://github.com/jeytekdev"
        }
    ],
    "require": {
        "php": "^8.1",
        "jeytekdev/explain-lint": "^2.0",
        "illuminate/database": "^10.0 || ^11.0 || ^12.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Jeytekdev\\ExplainLint\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jeytekdev\\ExplainLint\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jeytekdev\\ExplainLint\\Laravel\\ExplainLintServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-master": "2.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
